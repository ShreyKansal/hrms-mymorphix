{
  "name": "hrms",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "functions:deploy": "supabase functions deploy",
    "functions:serve": "supabase functions serve"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
