// HRMS — Prisma schema
// Sprint 0 + Sprint 1-2 scope only (Tenant/Org/Legal Entity + Employee/Employment Assignment + Roles/Permissions).
// See docs/hrms-prd/05-organisation-data-model.md and docs/hrms-prd/08-conceptual-data-model.md for the full model
// this will grow into. Every table carries tenant_id for row-level tenant isolation
// (docs/hrms-prd/10-security-privacy-audit.md §1) — RLS policies are applied via a separate migration SQL file,
// not expressible in the Prisma schema syntax itself.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Sprint 0: root tenancy ----------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  status    TenantStatus @default(PROVISIONING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisations Organisation[]
  users         User[]
  roles         Role[]

  @@map("tenants")
}

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DEPROVISIONED
}

model Organisation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String

  legalEntities LegalEntity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("organisations")
}

model LegalEntity {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  organisationId String       @map("organisation_id")
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  isActive       Boolean      @default(true) @map("is_active")

  departments Department[]
  locations   Location[]
  employees   Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("legal_entities")
}

// ---------- Sprint 3 (Module 2), included now since Employment Assignment references it ----------

model Department {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  legalEntityId String      @map("legal_entity_id")
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id])
  name          String
  parentId      String?     @map("parent_id")
  parent        Department? @relation("DepartmentToParent", fields: [parentId], references: [id])
  children      Department[] @relation("DepartmentToParent")
  isActive      Boolean     @default(true) @map("is_active")

  assignments EmploymentAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("departments")
}

model Location {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  legalEntityId String      @map("legal_entity_id")
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id])
  name          String
  state         String? // matters later for Professional Tax, Module 6
  city          String?
  isActive      Boolean     @default(true) @map("is_active")

  assignments EmploymentAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("locations")
}

model Designation {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  title    String

  assignments EmploymentAssignment[]

  @@index([tenantId])
  @@map("designations")
}

model Grade {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  code     String
  name     String

  assignments EmploymentAssignment[]

  @@index([tenantId])
  @@map("grades")
}

// ---------- Sprint 1-2 (Module 1): Employee + Employment Assignment ----------
// See docs/hrms-prd/05-organisation-data-model.md §7 — this is the single most important
// pattern in the whole schema. Never edit a row's effective values in place; always create
// a new row and close out the old one.

model Employee {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  legalEntityId String      @map("legal_entity_id")
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id])

  employeeCode String   @map("employee_code") // human-facing ID, configurable numbering scheme later (Module 22)
  legalName    String   @map("legal_name")
  dateOfBirth  DateTime? @map("date_of_birth")
  gender       String?

  // Government IDs — masked at the API layer per docs/hrms-prd/modules/01-core-hr-employee-information.md §12.
  // Unique per tenant, not globally, per that module's §11.
  panNumber    String? @map("pan_number")
  aadhaarHash  String? @map("aadhaar_hash") // store a hash, never the raw number, per security doc §2/§6

  personalEmail String? @map("personal_email")
  personalPhone String? @map("personal_phone")

  status EmployeeStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employmentAssignments EmploymentAssignment[]
  compensations         Compensation[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, panNumber])
  @@index([tenantId])
  @@map("employees")
}

enum EmployeeStatus {
  DRAFT
  ACTIVE
  ON_LEAVE
  SUSPENDED
  SEPARATION_INITIATED
  SEPARATED
}

model EmploymentAssignment {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  employeeId String    @map("employee_id")
  employee   Employee  @relation(fields: [employeeId], references: [id])

  departmentId  String?      @map("department_id")
  department    Department?  @relation(fields: [departmentId], references: [id])
  locationId    String?      @map("location_id")
  location      Location?    @relation(fields: [locationId], references: [id])
  designationId String?      @map("designation_id")
  designation   Designation? @relation(fields: [designationId], references: [id])
  gradeId       String?      @map("grade_id")
  grade         Grade?       @relation(fields: [gradeId], references: [id])

  managerId String?   @map("manager_id") // self-referential to Employee.id, functional manager
                                          // (not a Prisma relation to avoid a circular-required-field
                                          // issue — resolved in application code per docs/hrms-prd/05 §5)

  employmentType String @map("employment_type") // Permanent / Contract / Intern / Consultant — see docs/hrms-prd/05 §3

  // The effective-dating pattern itself — see docs/hrms-prd/05-organisation-data-model.md §7.
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to") // null = current
  reasonCode    String    @map("reason_code") // "Promotion" | "Transfer" | "ManagerChange" | "Correction" | ...
  approvalRef   String?   @map("approval_ref") // links to a Module 17 workflow instance, once that exists

  createdAt DateTime @default(now())

  @@index([tenantId, employeeId, effectiveFrom]) // the single most important index in this schema —
                                                   // every "what was true on date X" query uses this.
  @@map("employment_assignments")
}

model Compensation {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id])

  ctcAnnual  Decimal  @map("ctc_annual") @db.Decimal(14, 2)
  currency   String   @default("INR")

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  reasonCode    String    @map("reason_code")
  approvalRef   String?   @map("approval_ref")

  createdAt DateTime @default(now())

  @@index([tenantId, employeeId, effectiveFrom])
  @@map("compensations")
}

// ---------- Sprint 1-2 (Module 21): Roles and Permissions ----------
// Deliberately simple for Sprint 1 — full field-level masking and scope-resolution logic
// lives in application code (packages/permissions), not modeled exhaustively in SQL here.

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String   @map("password_hash")
  employeeId   String?  @unique @map("employee_id") // linked once the person also has an Employee record

  roleAssignments RoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String
  isSystemRole Boolean @default(false) @map("is_system_role")

  // Capability matrix: { "module": "employees", "action": "edit", "field": "compensation" } style grants.
  // Modeled as JSON for Sprint 1 velocity — revisit as a normalized table once the real capability
  // list stabilizes (see docs/hrms-prd/modules/21-roles-permissions.md §9).
  permissions Json

  roleAssignments RoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("roles")
}

model RoleAssignment {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])
  roleId String @map("role_id")
  role   Role   @relation(fields: [roleId], references: [id])

  scopeType  String  @map("scope_type") // "self" | "team" | "department" | "location" | "legal_entity" | "custom"
  scopeValue Json?   @map("scope_value") // e.g. { "departmentId": "..." } — interpreted by packages/permissions

  expiresAt DateTime? @map("expires_at") // per docs/hrms-prd/modules/21-roles-permissions.md §7.1 — temporary grants

  createdAt DateTime @default(now())

  @@map("role_assignments")
}
